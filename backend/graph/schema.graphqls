# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Todo {
  id: ID!
  text: String!
  done: Boolean!
  user: User!
}

type Role {
  id: Int!
  name: String!
  description: String
}

type User {
  id: ID!
  email: String!
  username: String!
  name: String!
  isSuperadmin: Boolean!
  isActive: Boolean!
}

input NewTodo {
  text: String!
  userId: String!
}

input RegisterInput {
  email: String!
  username: String!
  password: String!
  name: String!
}

type Query {
  todos: [Todo!]!
  roles: [Role!]!
}

type Mutation {
  createTodo(input: NewTodo!): Todo!
  register(input: RegisterInput!): User!
}
