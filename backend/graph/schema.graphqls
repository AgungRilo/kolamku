# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Todo {
  id: ID!
  text: String!
  done: Boolean!
  user: User!
}

type Role {
  id: Int!
  name: String!
  description: String
}

type User {
  id: ID!
  name: String!
}

type Query {
  todos: [Todo!]!
  roles: [Role!]!
}

input NewTodo {
  text: String!
  userId: String!
}

type Mutation {
  createTodo(input: NewTodo!): Todo!
}
